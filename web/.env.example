# Frontend build/runtime config (Vite). Copy to .env.local for local overrides.
# Never commit real secrets — none of these are secrets (the SPA is a public client).

# Real OIDC login (auth-code + PKCE). Set BOTH to switch OFF the dev-header path.
# The SPA must be a PUBLIC Keycloak client with standard flow + PKCE enabled, whose
# redirect URI matches the app origin, and whose access-token `aud` satisfies the
# gateway's OidcAuthenticator audience (configure a Keycloak audience mapper).
# VITE_OIDC_AUTHORITY=https://keycloak.example/realms/scree
# VITE_OIDC_CLIENT_ID=scree-web
# Fixed callback path registered with the Keycloak client (default "/"). The redirect
# URI is origin + this path — register exactly that. Never the live page path.
# VITE_OIDC_REDIRECT_PATH=/

# Local dev only (used when OIDC is unset): which X-Spike-User the dev-header path sends.
# Requires the gateway started with allow_insecure_header_auth.
# VITE_DEV_USER=rivera
