# Scree gateway configuration — copy to `.env` and fill in for a production run.
# In DEV mode (SCREE_DEV=1) everything below is ignored: the gateway uses dev
# header auth and in-memory stores, so it boots with no external services.
# In production (SCREE_DEV unset/0) every value marked REQUIRED must be set or
# the gateway fails closed at startup (scree.asgi._require).

# Set to 1 for a local demo; leave unset/0 for production.
SCREE_DEV=0

# --- Identity: Keycloak / OIDC (REQUIRED in prod) ---
# Bearer-token verification (the auth currency).
OIDC_ISSUER=https://keycloak.example/realms/scree
OIDC_AUDIENCE=scree-gateway
OIDC_JWKS_URL=https://keycloak.example/realms/scree/protocol/openid-connect/certs
# RFC 8693 token exchange: user OIDC token -> GitLab-audience token (INV-ID-1).
OIDC_TOKEN_URL=https://keycloak.example/realms/scree/protocol/openid-connect/token
OIDC_CLIENT_ID=scree-gateway
OIDC_CLIENT_SECRET=                       # supply via secret manager, never commit

# --- GitLab (REQUIRED in prod) ---
GITLAB_URL=https://gitlab.example
GITLAB_AUDIENCE=gitlab                    # audience of the exchanged token

# --- Vault Transit: ticket/space crypto (REQUIRED in prod) ---
VAULT_ADDR=https://vault.example
VAULT_TOKEN=                              # supply via secret manager, never commit

# --- OpenFGA: ticket ReBAC (REQUIRED in prod) ---
OPENFGA_URL=http://openfga:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# --- Git-backed stores (optional; in-memory if unset) ---
# Local working clones of the knowledge / risk repos. Mutations are commits.
SCREE_DOCS_REPO=/repos/docs
SCREE_RISKS_REPO=/repos/risks
# Path prefixes that require an MR (branch protection) instead of direct commit.
SCREE_GOVERNED_PREFIXES=policy/,hr/

# --- Principals (optional; comma-separated) ---
SCREE_SERVICE_PRINCIPALS=svc:poller,svc:slackbot,svc:indexer,svc:migrator
SCREE_COMPLIANCE_PRINCIPALS=dpo:alice
SCREE_AGENT_PRINCIPALS=agent:dani

# --- Static web ---
# Directory of the built SPA served at / (set by the Docker image; override only
# if you run the gateway outside the image).
# SCREE_WEB_DIR=/app/web
